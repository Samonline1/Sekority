// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AlertTemplate {
  id        String   @id @default(cuid())
  channel   String   @unique // EMAIL, SMS, WHATSAPP, CALL
  subject   String?  // Optional subject for Email
  body      String   // The text or template
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertLog {
  id                String   @id @default(cuid())
  triggeredAt       DateTime @default(now())
  ipAddress         String?
  userAgent         String?
  
  // Independent channel outcomes
  emailStatus       String   @default("PENDING") // SENT, FAILED, SKIPPED
  emailMessageId    String?
  emailError        String?
  
  callStatus        String   @default("PENDING") // SENT, FAILED, SKIPPED
  callMessageId     String?
  callError         String?

  smsStatus         String   @default("PENDING") // SENT, FAILED, SKIPPED
  smsMessageId      String?
  smsError          String?
  
  whatsappStatus    String   @default("PENDING") // SENT, FAILED, SKIPPED
  whatsappMessageId String?
  whatsappError     String?

  createdAt         DateTime @default(now())
}

model ChatUser {
  id        String        @id @default(cuid())
  userId    String        @unique // unique identifier e.g. "user_primary", "contact_alice"
  name      String        // display name
  code      String        // secret entrance passcode
  role      String        @default("USER")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      ChatUser @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userName  String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Journey {
  id                    String    @id @default(cuid())
  userId                String    @default("user_sb")
  fromLocation          String
  toLocation            String
  purpose               String?
  transportMode         String    @default("CAB") // CAB, BUS, METRO, WALKING, CAR
  trackingUrl           String?   // e.g. Uber/Ola share ride URL
  expectedDurationMins  Int
  expectedArrivalAt     DateTime
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  actualDurationMinutes Int?
  status                String    @default("ACTIVE") // ACTIVE, COMPLETED, DELAYED, CANCELLED
  notifiedStarted       Boolean   @default(false)
  notifiedOverdue       Boolean   @default(false)
  notifiedCompleted     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
}

model EmergencyContact {
  id               String   @id @default(cuid())
  userId           String   @default("user_sb")
  name             String
  phone            String
  email            String?
  relationship     String?  @default("Trusted Contact") // Family, Friend, Doctor, Colleague
  isPrimary        Boolean  @default(false)
  verified         Boolean  @default(true)
  notifyByTelegram Boolean  @default(true)
  notifyByEmail    Boolean  @default(true)
  notifyBySMS      Boolean  @default(false)
  notifyByWhatsApp Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model SafetyCheckin {
  id           String    @id @default(cuid())
  userId       String    @default("user_sb")
  destination  String?
  message      String?
  durationMins Int       @default(30)
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  completedAt  DateTime?
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, ESCALATED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}
